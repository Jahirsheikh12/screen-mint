// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.jahirsheikh.screenmint",
  "afterPack": "./scripts/after-pack.cjs",
  "asar": true,
  "asarUnpack": [
    "node_modules/ffmpeg-static/ffmpeg*",
    "node_modules/uiohook-napi/build/Release/*.node",
    "node_modules/uiohook-napi/prebuilds/*/*.node",
    "electron/native/**"
  ],
  "productName": "ScreenMint",
  "npmRebuild": true,
  "buildDependenciesFromSource": true,
  "compression": "normal",
  "publish": [
    {
      "provider": "github",
      "owner": "Jahirsheikh12",
      "repo": "screen-mint",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "dist-electron",
    "electron/native",
    "!dist/wallpapers{,/**}",
    // Renderer-only libraries: Vite bundles them into dist, and nothing loads them from node_modules.
    "!node_modules/pixi.js{,/**}",
    "!node_modules/lucide-react{,/**}",
    "!node_modules/@mediapipe/tasks-vision{,/**}",
    "!**/node_modules/ffmpeg-static/{LICENSE,README.md,example.js,ffmpeg.LICENSE,ffmpeg.README,install.js,types{,/**}}",
    "!*.png",
    "!preview*.png",
    "!*.md",
    "!README.md",
    "!CONTRIBUTING.md",
    "!LICENSE"
  ],
  "extraResources": [
    {
      "from": ".tmp/packaged-assets/assets",
      "to": "assets"
    }
  ],

  "mac": {
    "identity": "-",
    "hardenedRuntime": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "icons/icons/mac/icon.icns",
    "artifactName": "ScreenMint-${arch}.${ext}",
    "extendInfo": {
      "NSAudioCaptureUsageDescription": "ScreenMint needs audio capture permission to record system audio.",
      "NSMicrophoneUsageDescription": "ScreenMint needs microphone access to record voice audio.",
      "NSSpeechRecognitionUsageDescription": "ScreenMint needs speech recognition access to generate local captions.",
      "NSCameraUseContinuityCameraDeviceType": true,
      "com.apple.security.device.audio-input": true
    }
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "icons/icons/png",
    "artifactName": "ScreenMint-linux-${arch}.${ext}",
    "category": "AudioVideo"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "icons/icons/win/icon.ico"
    ,
    "artifactName": "ScreenMint-windows-${arch}.${ext}"
  }
}

