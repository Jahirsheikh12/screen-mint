{
	"name": "screenmint",
	"productName": "ScreenMint",
	"description": "A free, creator-focused screen recorder with auto-zoom, cursor effects, backgrounds, annotations, and a full timeline editor for polished videos out of the box.",
	"author": "Jahir Sheikh",
	"homepage": "https://screenmint.live",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jahirsheikh12/screen-mint.git"
	},
	"bugs": {
		"url": "https://github.com/Jahirsheikh12/screen-mint/issues"
	},
	"version": "1.0.3",
	"type": "module",
	"scripts": {
		"dev": "npm run wallpapers:thumbs && vite",
		"postinstall": "npm run rebuild:native",
		"brand:generate": "node scripts/generate-brand-assets.mjs",
		"wallpapers:thumbs": "node scripts/generate-wallpaper-thumbs.mjs",
		"build:asset-pack": "npm run wallpapers:thumbs && node scripts/build-packaged-assets.mjs",
		"build:renderer": "tsc && vite build && node scripts/prepare-packaged-dist.mjs",
		"build": "npm run build:native-helpers && npm run build:asset-pack && npm run build:renderer && electron-builder --publish never",
		"version:show": "node scripts/bump-version.mjs --show",
		"version:patch": "node scripts/bump-version.mjs patch",
		"version:minor": "node scripts/bump-version.mjs minor",
		"version:major": "node scripts/bump-version.mjs major",
		"version:set": "node scripts/bump-version.mjs",
		"lint": "npm run lint:app",
		"lint:app": "biome check src/components/video-editor src/lib/exporter src/lib/updater src/hooks electron/updater.ts",
		"lint:repo": "biome check src electron scripts website *.ts *.json *.json5 *.cjs *.md",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"rebuild:native": "electron-rebuild --force --only uiohook-napi",
		"build:native-helpers": "node scripts/build-native-helpers.mjs",
		"build:wgc-capture": "node scripts/build-wgc-capture.mjs",
		"build:cursor-monitor": "node scripts/build-cursor-monitor.mjs",
		"build:mac": "npm run build:native-helpers && npm run build:asset-pack && npm run build:renderer && electron-builder --mac --publish never && npm run validate:mac-bundle -- release/mac/ScreenMint.app release/mac-arm64/ScreenMint.app",
		"test:mac:prod": "bash scripts/test-local-macos-production.sh",
		"build:win": "npm run build:wgc-capture && npm run build:cursor-monitor && npm run build:asset-pack && npm run build:renderer && electron-builder --win --publish never",
		"build:linux": "npm run build:asset-pack && npm run build:renderer && electron-builder --linux --publish never",
		"validate:mac-bundle": "node scripts/validate-mac-bundle.mjs",
		"release:validate-assets": "node scripts/validate-release-assets.mjs",
		"i18n:check": "node scripts/i18n-check.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"benchmark:export:native-composed": "node scripts/benchmark-native-composed-export.mjs",
		"release:validate-provenance": "node scripts/validate-asset-provenance.mjs",
		"validate:host": "node scripts/validate-host.mjs"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "^0.10.34",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dnd-timeline": "^2.2.0",
		"electron-updater": "^6.8.3",
		"ffmpeg-static": "^5.3.0",
		"gifenc": "^1.0.3",
		"lucide-react": "^0.545.0",
		"mediabunny": "^1.25.1",
		"motion": "^12.23.24",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.14.0",
		"qrcode": "^1.5.4",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-resizable-panels": "^3.0.6",
		"react-rnd": "^10.5.2",
		"selfsigned": "^5.5.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"uiohook-napi": "^1.5.4",
		"uuid": "^13.0.0",
		"web-demuxer": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@types/node": "^25.0.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18.2.64",
		"@types/react-dom": "^18.2.21",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^4.2.1",
		"autoprefixer": "^10.4.21",
		"electron": "^39.2.7",
		"electron-builder": "^26.7.0",
		"electron-rebuild": "^3.2.9",
		"fast-check": "^4.5.2",
		"postcss": "^8.5.6",
		"shadcn": "^4.11.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^3.4.18",
		"terser": "^5.44.1",
		"typescript": "^5.2.2",
		"vite": "^5.1.6",
		"vite-plugin-electron": "^0.28.6",
		"vite-plugin-electron-renderer": "^0.14.5",
		"vitest": "^4.0.16"
	},
	"main": "dist-electron/main.js"
}
